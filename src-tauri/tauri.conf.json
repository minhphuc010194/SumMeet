{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SumMeet",
  "version": "1.1.5",
  "identifier": "ai.summarizebot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3040",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SumMeet — AI Meeting Copilot",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://openrouter.ai; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "shortDescription": "Ghi âm & Tóm tắt cuộc họp bằng AI",
    "longDescription": "Ứng dụng ghi âm cuộc họp (Micro + Âm thanh hệ thống), gỡ băng thời gian thực, tóm tắt thông minh và hỏi đáp AI.",
    "copyright": "Ứng dụng ghi âm cuộc họp (Micro + Âm thanh hệ thống), gỡ băng thời gian thực, tóm tắt thông minh và hỏi đáp AI.\n\n© 2026 SumMeet",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFRENFQUU0NjA1NkM3NzYKUldSMngxWmc1T3JjM2pEM0NIRXBMMlZnZ01yK3djMGFOQTM3NTB5Z0FpQURkaHNQdFA5ckxoUHYK",
      "endpoints": [
        "https://github.com/minhphuc010194/SumMeet/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
